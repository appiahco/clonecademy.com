---
import ArrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg";
import CtaBand from "../components/cta-band.astro";
import PageHeader from "../components/page-header.astro";
import Schedule from "../components/schedule.astro";
import SectionHeading from "../components/section-heading.astro";
import SprintList from "../components/sprint-list.astro";
import { teamOptions, week } from "../data/program";
import { cohort } from "../data/site";
import Layout from "../layouts/index.astro";
import { getProducts, getRoles } from "../lib/content";
import { icons } from "../lib/icons";

const roles = await getRoles();
const products = await getProducts();
const [sample] = products;
---

<Layout
	title="How it works"
	description="How a Clonecademy cohort runs: four roles form a team, the team clones a real product in sprints, then builds a startup of its own."
>
	<PageHeader
		title="Sixteen weeks inside a startup engineering team"
		lede={`Four founders, four roles, one product. Learn your role's stack, clone Amazon or Instagram together, then build one of your own. About ${cohort.hoursPerWeek} hours a week, fully remote, and no coding experience needed.`}
	/>

	<section class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
		<div class="grid gap-14 lg:grid-cols-12">
			<SectionHeading
				class="lg:col-span-5"
				title="Your team"
				intro="Each role owns part of the product and depends on the others. That's the point: you learn to build software the way it's built at a startup, by handing work to each other."
			/>
			<ul class="grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:col-span-7">
				{
					roles.map((role) => {
						const Icon = icons[role.data.icon];
						return (
							<li class="bg-background p-6">
								<Icon class="size-7 text-ink" aria-hidden="true" />
								<p class="mt-4 font-semibold">{role.data.title}</p>
								<p class="mt-1 text-sm text-muted-foreground">{role.data.owns}</p>
							</li>
						);
					})
				}
			</ul>
		</div>
		<div class="mt-16 grid gap-10 md:grid-cols-2">
			{
				teamOptions.map((option) => (
					<div class="border-t border-border pt-6">
						<h3 class="text-xl font-semibold">{option.title}</h3>
						<p class="mt-3 max-w-lg leading-relaxed text-muted-foreground">
							{option.detail}
						</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="border-y border-border bg-muted/50">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
			<SectionHeading
				title="The sixteen weeks"
				intro="Three phases and a demo day. Your team stays together from week 4 to the end."
			/>
			<div class="mt-14"><Schedule /></div>
		</div>
	</section>

	<section class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
		<div class="grid gap-14 lg:grid-cols-12">
			<div class="lg:col-span-5">
				<SectionHeading
					title="Cloning, in sprints"
					intro="From week 4 your team works in two-week sprints with a goal the whole product has to meet. Here's the plan for the Amazon clone."
				/>
				<a
					href={`/projects/${sample.id}`}
					class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium hover:text-primary"
				>
					See the full {sample.data.name} teardown
					<ArrowRight class="size-4" aria-hidden="true" />
				</a>
			</div>
			<SprintList class="lg:col-span-7" sprints={sample.data.sprints} />
		</div>
	</section>

	<section class="border-t border-border">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
			<SectionHeading title="What a week looks like" />
			<dl class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
				{
					week.map((item) => (
						<div>
							<dt class="text-lg font-semibold">{item.title}</dt>
							<dd class="mt-2 leading-relaxed text-muted-foreground">{item.detail}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="border-t border-border">
		<div class="mx-auto grid max-w-7xl gap-10 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-2 lg:px-8">
			<div>
				<h2 class="text-3xl font-bold tracking-[-0.025em] sm:text-4xl">After demo day</h2>
				<p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
					You keep your code, your team and access to every recording. Many
					alumni come back for another role, often with the same team
					swapping seats, so each founder understands the whole stack.
				</p>
			</div>
			<div class="lg:pt-2">
				<p class="max-w-xl leading-relaxed text-muted-foreground">
					The Full-stack founder pass covers all four roles across four
					cohorts. Most founders take them in whatever order their startup
					needs, starting with the role they'd otherwise hire first.
				</p>
				<a
					href="/pricing"
					class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium hover:text-primary"
				>
					Compare plans
					<ArrowRight class="size-4" aria-hidden="true" />
				</a>
			</div>
		</div>
	</section>

	<CtaBand />
</Layout>
