---
import ArrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg";
import CtaBand from "../../components/cta-band.astro";
import PageHeader from "../../components/page-header.astro";
import SectionHeading from "../../components/section-heading.astro";
import Teardown from "../../components/teardown.astro";
import { alumniProducts } from "../../data/outcomes";
import Layout from "../../layouts/index.astro";
import { getLayers, getProducts } from "../../lib/content";
import { icons } from "../../lib/icons";

const products = await Promise.all(
	(await getProducts()).map(async (product) => ({
		product,
		layers: await getLayers(product),
	})),
);
---

<Layout
	title="Projects"
	description="What Clonecademy teams ship: an Amazon-style marketplace or an Instagram-style social app, then a startup of their own."
>
	<PageHeader
		title="Two products to clone, then one of your own"
		lede="Each team picks Amazon or Instagram. Both are big enough to keep all four roles busy for nine weeks, and when you get stuck, the real thing shows you the answer."
	/>

	{
		products.map(({ product, layers }, index) => {
			const Icon = icons[product.data.icon];
			return (
				<section class:list={["border-b border-border", index % 2 === 1 && "bg-muted/50"]}>
					<div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-12 lg:px-8">
						<div class:list={["lg:col-span-5", index % 2 === 1 && "lg:order-last lg:col-start-8"]}>
							<Icon class="size-10" aria-hidden="true" />
							<h2 class="mt-5 text-4xl font-bold tracking-[-0.025em] sm:text-5xl">
								{product.data.name} clone
							</h2>
							<p class="mt-2 text-lg font-medium text-ink">{product.data.kind}</p>
							<p class="mt-5 max-w-md text-lg leading-relaxed text-muted-foreground">
								{product.data.summary}
							</p>
							<a
								href={`/projects/${product.id}`}
								class="mt-8 inline-flex items-center gap-1.5 font-medium hover:text-primary"
							>
								See what each role ships
								<ArrowRight class="size-4" aria-hidden="true" />
							</a>
						</div>
						<div class:list={["lg:col-span-7", index % 2 === 1 && "lg:col-span-6 lg:col-start-1"]}>
							<Teardown product={product.data.name} layers={layers} />
						</div>
					</div>
				</section>
			);
		})
	}

	<section class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
		<SectionHeading
			title="What alumni built next"
			intro="In weeks 13 to 15, teams build one teammate's startup with the same stack. A few that kept going:"
		/>
		<ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2">
			{
				alumniProducts.map((item) => (
					<li class="border-t border-border pt-6">
						<h3 class="text-xl font-semibold">{item.name}</h3>
						<p class="mt-2 leading-relaxed text-muted-foreground">{item.summary}</p>
						<p class="mt-3 text-sm">
							Cohort {item.cohort}, after cloning {item.clone}.
							<span class="text-ink"> {item.status}.</span>
						</p>
					</li>
				))
			}
		</ul>
	</section>

	<CtaBand />
</Layout>
