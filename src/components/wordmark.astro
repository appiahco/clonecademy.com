---
// The mark is an original (solid) and its clone (dashed), offset like a
// tracing laid over a drawing.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
	<svg
		viewBox="0 0 24 24"
		class="size-6 shrink-0"
		fill="none"
		aria-hidden="true"
	>
		<rect
			x="2"
			y="2"
			width="14"
			height="14"
			rx="2.5"
			stroke="currentColor"
			stroke-width="2"></rect>
		<rect
			x="8"
			y="8"
			width="14"
			height="14"
			rx="2.5"
			stroke="var(--ink)"
			stroke-width="2"
			stroke-dasharray="3 2.2"></rect>
	</svg>
	<span
		class="font-heading text-[1.3rem] leading-none font-bold tracking-[-0.03em]"
		>clonecademy</span
	>
</span>
