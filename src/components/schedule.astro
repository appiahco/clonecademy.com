---
import { phases } from "../data/program";
import { cohort } from "../data/site";

// Each phase gets a deeper tint of the ink, so the weeks read as progress.
const tints = [
	"bg-chart-1/60 dark:bg-chart-5",
	"bg-chart-3 dark:bg-chart-4",
	"bg-primary dark:bg-chart-2",
	"bg-foreground",
];
const weeks = Array.from({ length: cohort.weeks }, (_, i) => i + 1);
const label = (start: number, end: number) =>
	start === end ? `Week ${start}` : `Weeks ${start}–${end}`;
---

<div>
	<!-- The bar is to scale: one column per week. -->
	<div class="hidden md:block" aria-hidden="true">
		<div class="grid grid-cols-16 gap-1">
			{
				phases.map((phase, index) => (
					<div
						class:list={["h-4 rounded-sm", tints[index]]}
						style={`grid-column: ${phase.weeks[0]} / ${phase.weeks[1] + 1}`}
					/>
				))
			}
		</div>
		<ol class="mt-2 grid grid-cols-16 gap-1 text-xs text-muted-foreground tabular-nums">
			{weeks.map((week) => <li>{week}</li>)}
		</ol>
	</div>

	<ol class="grid gap-8 sm:grid-cols-2 md:mt-12 lg:grid-cols-4 lg:gap-10">
		{
			phases.map((phase, index) => (
				<li>
					<div class="flex items-center gap-3">
						<span class:list={["h-4 w-6 rounded-sm", tints[index]]} aria-hidden="true" />
						<span class="text-sm text-muted-foreground tabular-nums">
							{label(phase.weeks[0], phase.weeks[1])}
						</span>
					</div>
					<h3 class="mt-3 text-xl font-semibold tracking-tight">{phase.title}</h3>
					<p class="mt-2 leading-relaxed text-muted-foreground">{phase.summary}</p>
				</li>
			))
		}
	</ol>
</div>
