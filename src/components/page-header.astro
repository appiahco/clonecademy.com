---
interface Props {
	title: string;
	lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="relative isolate overflow-hidden border-b border-border">
	<div
		class="bg-drafting absolute inset-0 -z-10 mask-b-from-20% mask-b-to-100%"
		aria-hidden="true"
	>
	</div>
	<div class="mx-auto max-w-7xl px-4 pt-16 pb-14 sm:px-6 sm:pt-24 sm:pb-20 lg:px-8">
		<slot name="before" />
		<h1 class="display max-w-4xl text-5xl sm:text-6xl lg:text-7xl">{title}</h1>
		{
			lede && (
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
					{lede}
				</p>
			)
		}
		<slot />
	</div>
</header>
