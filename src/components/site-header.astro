---
import List from "@phosphor-icons/core/assets/regular/list.svg";
import X from "@phosphor-icons/core/assets/regular/x.svg";
import { nav, nextCohort, site } from "../data/site";
import Button from "./button.astro";
import ModeToggle from "./mode-toggle.astro";
import Wordmark from "./wordmark.astro";

const path = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) =>
	path === href || path.startsWith(`${href}/`);
---

<header
	class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md supports-[backdrop-filter]:bg-background/70"
	data-site-header
>
	<div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6 lg:px-8">
		<a
			href="/"
			class="rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
		>
			<Wordmark />
			<span class="sr-only">{site.name} home</span>
		</a>

		<nav aria-label="Main" class="ml-4 hidden lg:block">
			<ul class="flex items-center gap-1">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isCurrent(item.href) ? "page" : undefined}
								class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring aria-[current=page]:text-foreground aria-[current=page]:font-medium"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="ml-auto flex items-center gap-2">
			<ModeToggle />
			<Button href={site.applyHref} size="lg" class="hidden px-4 sm:inline-flex">
				Apply
			</Button>
			<Button
				type="button"
				variant="outline"
				size="icon"
				class="lg:hidden"
				aria-expanded="false"
				aria-controls="mobile-nav"
				data-mobile-nav-trigger
			>
				<List class="size-5 in-aria-expanded:hidden" aria-hidden="true" />
				<X class="hidden size-5 in-aria-expanded:block" aria-hidden="true" />
				<span class="sr-only">Menu</span>
			</Button>
		</div>
	</div>

	<nav
		id="mobile-nav"
		aria-label="Main"
		class="hidden border-t border-border lg:hidden"
		data-mobile-nav
	>
		<ul class="mx-auto flex max-w-7xl flex-col px-4 py-3 sm:px-6">
			{
				nav.map((item) => (
					<li>
						<a
							href={item.href}
							aria-current={isCurrent(item.href) ? "page" : undefined}
							class="block rounded-md px-2 py-3 text-lg font-medium text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground"
						>
							{item.label}
						</a>
					</li>
				))
			}
			<li class="pt-3 pb-2 sm:hidden">
				<Button href={site.applyHref} size="xl" class="w-full">
					Apply for Cohort {nextCohort.number}
				</Button>
			</li>
		</ul>
	</nav>
</header>

<script>
	const trigger = document.querySelector<HTMLButtonElement>(
		"[data-mobile-nav-trigger]",
	);
	const panel = document.querySelector<HTMLElement>("[data-mobile-nav]");

	if (trigger && panel) {
		const setOpen = (open: boolean) => {
			trigger.setAttribute("aria-expanded", String(open));
			panel.classList.toggle("hidden", !open);
		};
		trigger.addEventListener("click", () => {
			setOpen(trigger.getAttribute("aria-expanded") !== "true");
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") setOpen(false);
		});
		window.matchMedia("(min-width: 64rem)").addEventListener("change", () => {
			setOpen(false);
		});
	}
</script>
