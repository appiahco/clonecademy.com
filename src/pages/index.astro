---
import ArrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg";
import Button from "../components/button.astro";
import CtaBand from "../components/cta-band.astro";
import FaqList from "../components/faq-list.astro";
import Schedule from "../components/schedule.astro";
import SectionHeading from "../components/section-heading.astro";
import Teardown from "../components/teardown.astro";
import { faq } from "../data/faq";
import { alumniProducts } from "../data/outcomes";
import { formatPrice, pricing } from "../data/pricing";
import { teamOptions } from "../data/program";
import { cohort, formatDate, nextCohort, site } from "../data/site";
import { testimonials } from "../data/testimonials";
import Layout from "../layouts/index.astro";
import {
	getDeliverables,
	getLayers,
	getProducts,
	getRoles,
} from "../lib/content";
import { icons } from "../lib/icons";
import { homeGraph } from "../lib/structured-data";

const roles = await getRoles();
const products = await getProducts();
const amazon = products.find((p) => p.id === "amazon");
if (!amazon)
	throw new Error("The home page teardown needs the Amazon product.");
const heroLayers = await getLayers(amazon);

const facts = [
	{ term: "Next cohort", detail: `Starts ${formatDate(nextCohort.starts)}` },
	{ term: "Length", detail: `${cohort.weeks} weeks, fully remote` },
	{ term: "Time", detail: `About ${cohort.hoursPerWeek} hours a week` },
	{ term: "Experience", detail: "No coding needed" },
];
const faqPreview = faq.flatMap((group) => group.items).slice(0, 4);
const [featured, ...moreQuotes] = testimonials;
---

<Layout jsonLd={homeGraph}>
	<!-- Hero -->
	<section class="relative isolate overflow-hidden border-b border-border">
		<div
			class="bg-drafting absolute inset-y-0 right-0 -z-10 w-full mask-l-from-40% mask-l-to-90% lg:w-2/3"
			aria-hidden="true"
		>
		</div>
		<div
			class="mx-auto grid max-w-7xl items-center gap-12 px-4 pt-14 pb-16 sm:px-6 sm:pt-20 lg:grid-cols-12 lg:gap-8 lg:px-8 lg:pt-16 lg:pb-20"
		>
			<div class="lg:col-span-6">
				<h1 class="display text-[3.25rem] sm:text-7xl xl:text-[5.5rem]">
					Clone Amazon with a team. Then build your company.
				</h1>
				<p class="mt-7 max-w-xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
					Stop waiting on developers. In {cohort.weeks} weeks, you and three
					other founders ship a production clone of a product millions of
					people use, then turn the same skills on your own startup.
				</p>
				<div class="mt-9 flex flex-wrap gap-3">
					<Button href={site.applyHref} size="xl">
						Apply for Cohort {nextCohort.number}
					</Button>
					<Button href="/how-it-works" size="xl" variant="outline">
						How it works
					</Button>
				</div>
				<dl class="mt-12 grid max-w-lg grid-cols-2 gap-x-8 gap-y-5 border-t border-border pt-6">
					{
						facts.map((fact) => (
							<div>
								<dt class="text-sm text-muted-foreground">{fact.term}</dt>
								<dd class="mt-0.5 font-medium">{fact.detail}</dd>
							</div>
						))
					}
				</dl>
			</div>
			<div class="lg:col-span-6 lg:-mr-8">
				<Teardown product="Amazon" layers={heroLayers} animate />
			</div>
		</div>
	</section>

	<!-- The team -->
	<section class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
		<SectionHeading
			title="Four roles. One product. One team."
			intro="Pick one role. We match you with three founders who picked the others. Together you own the whole product, from the database to the app store, and learn to hand work off the way a real startup team does."
		/>
		<ul class="mt-14 grid border-y border-border sm:grid-cols-2 lg:grid-cols-4">
			{
				roles.map((role, index) => {
					const Icon = icons[role.data.icon];
					return (
						<li
							class:list={[
								"flex flex-col py-8 sm:px-6",
								index > 0 && "border-t border-border sm:border-t-0",
								index % 2 === 1 && "sm:border-l",
								index === 2 && "sm:border-t lg:border-t-0 lg:border-l",
								index === 3 && "sm:border-t lg:border-t-0",
								index === 0 && "sm:pl-0",
							]}
						>
							<Icon class="size-8 text-ink" aria-hidden="true" />
							<h3 class="mt-5 text-2xl font-semibold tracking-tight">
								{role.data.title}
							</h3>
							<p class="mt-1 text-sm font-medium text-ink">{role.data.owns}</p>
							<p class="mt-4 leading-relaxed text-muted-foreground">
								{role.data.summary}
							</p>
							<p class="mt-5 text-sm text-muted-foreground">
								{role.data.stack.join(", ")}
							</p>
							<a
								href={`/curriculum/${role.id}`}
								class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-medium hover:text-primary"
							>
								{role.data.short} curriculum
								<ArrowRight class="size-4" aria-hidden="true" />
							</a>
						</li>
					);
				})
			}
		</ul>
		<div class="mt-12 grid gap-8 md:grid-cols-2">
			{
				teamOptions.map((option) => (
					<div>
						<h3 class="text-lg font-semibold">{option.title}</h3>
						<p class="mt-2 max-w-lg leading-relaxed text-muted-foreground">
							{option.detail}
						</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Schedule -->
	<section class="border-y border-border bg-muted/50">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
			<SectionHeading
				title="From your first line of code to demo day"
				intro="Three weeks to learn your stack. Nine weeks to clone a product with your team. Three weeks to build your own. Then you demo both to founders and investors."
			/>
			<div class="mt-14">
				<Schedule />
			</div>
		</div>
	</section>

	<!-- Products -->
	<section class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
		<SectionHeading
			title="Ship a product millions of people already use"
			intro="Your team picks Amazon or Instagram and clones it end to end: web, mobile, payments, infrastructure and AI. It goes live in production, and it goes in your portfolio."
		/>
		<div class="mt-14 grid gap-6 lg:grid-cols-2">
			{
				products.map((product) => {
					const Icon = icons[product.data.icon];
					return (
						<article class="flex flex-col rounded-2xl border border-border p-6 sm:p-10">
							<div class="flex items-center gap-4">
								<Icon class="size-10" aria-hidden="true" />
								<div>
									<h3 class="text-3xl font-bold tracking-tight">
										{product.data.name} clone
									</h3>
									<p class="text-muted-foreground">{product.data.kind}</p>
								</div>
							</div>
							<p class="mt-6 leading-relaxed">{product.data.summary}</p>
							<dl class="mt-8 grid gap-5 border-t border-border pt-6">
								{roles.map((role) => (
									<div class="grid gap-1 sm:grid-cols-[7rem_1fr] sm:gap-4">
										<dt class="text-sm font-medium text-ink">
											{role.data.short}
										</dt>
										<dd class="text-sm text-muted-foreground">
											{getDeliverables(product, role.id).slice(0, 2).join(". ")}.
										</dd>
									</div>
								))}
							</dl>
							<a
								href={`/projects/${product.id}`}
								class="mt-auto inline-flex items-center gap-1.5 pt-8 font-medium hover:text-primary"
							>
								See the full {product.data.name} teardown
								<ArrowRight class="size-4" aria-hidden="true" />
							</a>
						</article>
					);
				})
			}
		</div>

		<div class="mt-20 grid gap-10 lg:grid-cols-12">
			<div class="lg:col-span-4">
				<h3 class="text-2xl font-semibold tracking-tight">
					Then you build your company
				</h3>
				<p class="mt-3 leading-relaxed text-muted-foreground">
					In weeks 13 to 15, your team points the same stack, habits and
					momentum at one teammate's startup. A few that alumni teams launched:
				</p>
				<a
					href="/outcomes"
					class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium hover:text-primary"
				>
					See alumni outcomes
					<ArrowRight class="size-4" aria-hidden="true" />
				</a>
			</div>
			<ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:col-span-8">
				{
					alumniProducts.map((item) => (
						<li class="border-l-2 border-ink pl-5">
							<p class="font-semibold">{item.name}</p>
							<p class="mt-1 text-sm leading-relaxed text-muted-foreground">
								{item.summary}
							</p>
							<p class="mt-2 text-sm text-ink">
								Cohort {item.cohort}, {item.status.toLowerCase()}
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Testimonials -->
	<section class="border-y border-border bg-muted/50">
		<div class="mx-auto grid max-w-7xl gap-14 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-12 lg:px-8">
			<figure class="lg:col-span-7">
				<blockquote
					class="font-heading text-3xl leading-[1.2] font-medium tracking-[-0.02em] text-balance sm:text-4xl"
				>
					<p>&ldquo;{featured.quote}&rdquo;</p>
				</blockquote>
				<figcaption class="mt-8">
					<p class="font-semibold">{featured.name}</p>
					<p class="text-sm text-muted-foreground">{featured.detail}</p>
				</figcaption>
			</figure>
			<div class="grid content-start gap-10 lg:col-span-5">
				{
					moreQuotes.map((item) => (
						<figure class="border-t border-border pt-6">
							<blockquote class="leading-relaxed">
								<p>&ldquo;{item.quote}&rdquo;</p>
							</blockquote>
							<figcaption class="mt-4 text-sm">
								<span class="font-semibold">{item.name}</span>
								<span class="block text-muted-foreground">{item.detail}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</section>

	<!-- Pricing and questions -->
	<section class="mx-auto grid w-full max-w-7xl gap-16 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-12 lg:px-8">
		<div class="lg:col-span-5">
			<h2 class="text-3xl font-bold tracking-[-0.025em] sm:text-4xl">Pricing</h2>
			<p class="mt-6 font-heading text-6xl font-bold tracking-tight">
				{formatPrice(pricing.perRole.upfront)}
			</p>
			<p class="mt-2 text-muted-foreground">
				per role, or {pricing.perRole.installments.count} monthly payments of {formatPrice(pricing.perRole.installments.amount)}
			</p>
			<ul class="mt-8 space-y-3 text-sm">
				<li>
					Teams of four save {pricing.teamDiscountPercent}% on every seat
				</li>
				<li>
					All four roles with the Full-stack founder pass, {formatPrice(pricing.fullStack.upfront)}
				</li>
				<li>Full refund, minus the deposit, in the first {pricing.refundDays} days</li>
			</ul>
			<Button href="/pricing" variant="outline" size="xl" class="mt-9">
				Compare plans
			</Button>
		</div>
		<div class="lg:col-span-7">
			<h2 class="text-3xl font-bold tracking-[-0.025em] sm:text-4xl">
				Common questions
			</h2>
			<div class="mt-8">
				<FaqList items={faqPreview} />
			</div>
			<a
				href="/faq"
				class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium hover:text-primary"
			>
				All questions
				<ArrowRight class="size-4" aria-hidden="true" />
			</a>
		</div>
	</section>

	<CtaBand />
</Layout>
