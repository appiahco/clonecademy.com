---
interface Props {
	title: string;
	intro?: string;
	id?: string;
	class?: string;
}
const { title, intro, id, class: className } = Astro.props;
---

<div class:list={["max-w-3xl", className]}>
	<h2 id={id} class="text-3xl font-bold tracking-[-0.025em] sm:text-4xl lg:text-5xl">
		{title}
	</h2>
	{
		intro && (
			<p class="mt-4 text-lg leading-relaxed text-muted-foreground">{intro}</p>
		)
	}
</div>
